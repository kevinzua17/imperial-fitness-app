# Imperial Fitness Web - entorno local
# Copia este archivo como .env y ajusta los valores reales.
VITE_API_BASE_URL=http://localhost:8000
VITE_DEV_MODE=false
VITE_SESSION_BOOTSTRAP=true
VITE_API_TIMEOUT_MS=45000
VITE_API_GET_CACHE_TTL_MS=12000
VITE_API_GET_CACHE_MAX_ENTRIES=80
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Biblioteca visual abierta de ejercicios (frontend, sin tocar Supabase)
VITE_ENABLE_OPEN_EXERCISE_DB=true
VITE_OPEN_EXERCISE_DB_URL=https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/dist/exercises.json
VITE_OPEN_EXERCISE_IMAGE_PREFIX=https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/
VITE_OPEN_EXERCISE_TIMEOUT_MS=9000

