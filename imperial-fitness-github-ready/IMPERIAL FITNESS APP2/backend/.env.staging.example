APP_ENV=staging
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SECRET_KEY=staging-secret-long-random
CORS_ORIGINS=https://staging.imperialfitnesgym.com.co
TRUSTED_HOSTS=staging.imperialfitnesgym.com.co,staging-api.onrender.com
STORAGE_MODE=cloudinary
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
REDIS_URL=redis://...
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=90
AI_MODE=local_rules
ENABLE_HSTS=true
METRICS_ENABLED=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@imperialfitnesgym.com.co