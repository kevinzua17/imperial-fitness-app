{
  "name": "imperial-fitness-ai-ecosystem",
  "private": true,
  "version": "1.21.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mobile:build": "npm run build && npx cap sync",
    "mobile:android": "npm run build && npx cap sync android && npx cap open android",
    "mobile:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "mobile:add:android": "npx cap add android",
    "mobile:add:ios": "npx cap add ios",
    "verify:frontend": "npm run typecheck && npm run test && npm run build",
    "quality:release": "python scripts/secret_scan.py && python scripts/production_readiness_check.py",
    "verify:release": "npm run quality:release && npm run verify:frontend"
  },
  "dependencies": {
    "@sentry/react": "^10.53.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "clsx": "2.1.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-is": "^19.2.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "3.4.0",
    "vitest": "^4.1.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "node": "22.x"
  }
}
