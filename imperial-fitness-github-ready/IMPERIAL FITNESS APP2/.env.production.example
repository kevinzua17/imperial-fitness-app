# Imperial Fitness Web - Vercel
# Configurar en Project Settings > Environment Variables.
VITE_API_BASE_URL=https://imperial-fitness-api.onrender.com
# Mantener false salvo que se configure un proxy /api con la URL real del backend.
VITE_USE_SAME_ORIGIN_API=false
VITE_DEV_MODE=false
VITE_SESSION_BOOTSTRAP=true
VITE_API_TIMEOUT_MS=45000
VITE_API_GET_CACHE_TTL_MS=12000
VITE_API_GET_CACHE_MAX_ENTRIES=80
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Fuente abierta disponible solo para revisión/importación de administradores y entrenadores; los clientes ven únicamente ejercicios aprobados por la API
VITE_ENABLE_OPEN_EXERCISE_DB=true
VITE_OPEN_EXERCISE_DB_URL=https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/dist/exercises.json
VITE_OPEN_EXERCISE_IMAGE_PREFIX=https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/
VITE_OPEN_EXERCISE_TIMEOUT_MS=9000

