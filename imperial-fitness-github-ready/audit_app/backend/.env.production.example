APP_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SECRET_KEY=production-secret-long-random
CORS_ORIGINS=https://imperialfitnesgym.com.co,https://www.imperialfitnesgym.com.co
TRUSTED_HOSTS=imperialfitnesgym.com.co,www.imperialfitnesgym.com.co,api.imperialfitnesgym.com.co
STORAGE_MODE=cloudinary
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
REDIS_URL=redis://...
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=90
AI_MODE=local_rules
ENABLE_HSTS=true
METRICS_ENABLED=true
SENTRY_DSN=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@imperialfitnesgym.com.co
SMTP_FROM_NAME=Imperial Fitness
FRONTEND_URL=https://imperialfitnesgym.com.co
BACKEND_URL=https://api.imperialfitnesgym.com.co
LOG_LEVEL=INFO
