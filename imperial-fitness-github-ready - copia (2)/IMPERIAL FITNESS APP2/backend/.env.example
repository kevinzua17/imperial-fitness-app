# Imperial Fitness API - entorno local seguro
# Copia este archivo como backend/.env y reemplaza SOLO en tu entorno real.
APP_NAME=Imperial Fitness API
APP_ENV=local
DATABASE_URL=sqlite:///./imperial_fitness.db
SECRET_KEY=change-this-secret-key-before-production-use-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_EXPIRE_MINUTES=30

# Dominios permitidos
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Seguridad / límites
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=90
REDIS_URL=
SLOWAPI_ENABLED=true
CACHE_TTL_SECONDS=300
AUDIT_LOG_ENABLED=true
REQUEST_ID_HEADER=X-Request-ID
SIGNED_URL_EXPIRE_SECONDS=600

# Jobs
ASYNC_JOBS_ENABLED=false
RQ_QUEUE_NAME=imperial-default

# Supabase / storage externo
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_MODE=local
UPLOAD_DIR=uploads
PRIVATE_UPLOAD_DIR=private_uploads
MAX_UPLOAD_SIZE_MB=8
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Branding
DEFAULT_LOGO_URL=/logo-imperial-fitness.png
DEFAULT_AVATAR_URL=https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=150&auto=format&fit=crop&q=80
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# IA
AI_MODE=local_rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30

# Cookies / observabilidad
REFRESH_COOKIE_NAME=imperial_refresh_token
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO
BETTERSTACK_SOURCE_TOKEN=
UPTIME_CHECK_TOKEN=

# Correo
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Imperial Fitness
SMTP_USE_TLS=true

# Headers de seguridad
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000
CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' http://localhost:8000 http://127.0.0.1:8000 https:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
METRICS_ENABLED=true

# Rendimiento recomendado para piloto
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_AUTO_CREATE=false
DB_DISABLE_PREPARED_STATEMENTS=true
