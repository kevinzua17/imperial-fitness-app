# ============================================================
# RENDER / RAILWAY - VARIABLES DEL BACKEND FASTAPI
# Copiar estas variables en el panel del backend.
# No poner estas claves en Vercel ni en el frontend.
# ============================================================

APP_ENV=production
APP_NAME=Imperial Fitness API

# Supabase PostgreSQL. Usar la connection string de Supabase.
# Recomendado: usar Transaction Pooler si el servicio es serverless o gratuito.
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://vaaeaqdbocfnfasiznyl.supabase.co
SUPABASE_ANON_KEY=PEGAR_AQUI_LA_ANON_KEY_PUBLICA_SI_LA_NECESITAS

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=PEGAR_AQUI_UNA_CLAVE_LARGA_SEGURA

# URLs definitivas del piloto. Cambiar cuando ya tengas los dominios reales.
FRONTEND_URL=https://imperial-fitness-piloto.vercel.app
BACKEND_URL=https://imperial-fitness-api.onrender.com

# CORS: debe incluir exactamente la URL del frontend.
CORS_ORIGINS=https://imperial-fitness-piloto.vercel.app

# Trusted hosts: dominio del backend sin https://
TRUSTED_HOSTS=imperial-fitness-api.onrender.com

# Seguridad / producción
ENABLE_HSTS=true
METRICS_ENABLED=true
LOG_LEVEL=INFO

# Redis / Upstash
REDIS_URL=redis://default:password@host:port
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=90

# Cloudinary
STORAGE_MODE=cloudinary
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# SMTP - opción Brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=tu_usuario_smtp
SMTP_PASSWORD=tu_password_smtp
SMTP_FROM_EMAIL=no-reply@tudominio.com
SMTP_FROM_NAME=Imperial Fitness
SMTP_USE_TLS=true

# IA del especialista: local_rules no consume API externa.
AI_MODE=local_rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Sentry opcional para errores
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
