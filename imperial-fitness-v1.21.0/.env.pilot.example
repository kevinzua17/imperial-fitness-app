# Frontend piloto local apuntando a backend publicado
VITE_API_BASE_URL=https://imperial-fitness-api.onrender.com
VITE_DEV_MODE=false
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Supabase pública del proyecto piloto. El frontend actual consume el backend FastAPI;
# esta URL queda documentada por si luego se integra Supabase directo en cliente.
VITE_SUPABASE_URL=https://vaaeaqdbocfnfasiznyl.supabase.co
VITE_SUPABASE_ANON_KEY=PEGAR_AQUI_LA_ANON_KEY_PUBLICA_SI_LA_USAS_EN_FRONTEND

# Rendimiento recomendado para piloto de hasta 500 usuarios
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
# Biblioteca visual abierta de ejercicios (frontend, sin tocar Supabase)
VITE_ENABLE_OPEN_EXERCISE_DB=true
VITE_OPEN_EXERCISE_DB_URL=https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/dist/exercises.json
VITE_OPEN_EXERCISE_IMAGE_PREFIX=https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/
VITE_OPEN_EXERCISE_TIMEOUT_MS=9000

